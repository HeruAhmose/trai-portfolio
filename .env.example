# Production domain, injected into canonical/og/sitemap at build time.
VITE_SITE_URL=https://trai.org

# Optional analytics (the index.html references these; blank disables them).
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional comma-separated dev-server hostnames beyond localhost.
TRAI_VITE_ALLOWED_HOSTS=
